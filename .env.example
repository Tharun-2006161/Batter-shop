# Server
PORT=3000
JWT_SECRET=your-secret-key-here

# MongoDB Connection
# For local: mongodb://localhost:27017/batter_shop
# For Atlas: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/batter_shop
MONGODB_URI=mongodb://localhost:27017/batter_shop

# Admin Email (receives order notifications)
ADMIN_EMAIL=your-admin-email@gmail.com

# SMTP Email Configuration (for sending order notifications)
# Use Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Razorpay (for online payments - OPTIONAL)
# Get keys from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Pricing (in INR)
IDLI_BATTER_PRICE=25
DOSA_BATTER_PRICE=25
